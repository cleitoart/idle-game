[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/combat/combatant.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/combat/hp_bar.tscn" id="2_hp"]

[node name="Combatant" type="VBoxContainer"]
custom_minimum_size = Vector2(260, 320)
alignment = 1
script = ExtResource("1_script")

[node name="HpBar" parent="." instance=ExtResource("2_hp")]

[node name="BodyStage" type="Control" parent="."]
custom_minimum_size = Vector2(220, 220)
size_flags_horizontal = 4
mouse_filter = 2

[node name="Body" type="ColorRect" parent="BodyStage"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.5, 0.5, 0.5, 1)

[node name="AnimatedSprite2D" type="AnimatedSprite2D" parent="BodyStage"]
texture_filter = 1
visible = false

[node name="NameLabel" type="Label" parent="."]
text = "Combatant"
horizontal_alignment = 1

[node name="AttackTimer" type="Timer" parent="."]
wait_time = 1.0
autostart = false

[connection signal="resized" from="BodyStage" to="." method="_on_body_stage_resized"]
[connection signal="timeout" from="AttackTimer" to="." method="_on_attack_timer_timeout"]
